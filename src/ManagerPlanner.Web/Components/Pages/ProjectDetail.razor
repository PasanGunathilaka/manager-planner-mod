@page "/projects/{Id:int}"
@using ManagerPlanner.Core.Services
@inject PlanningService PlanningService

<PageTitle>Project Detail</PageTitle>

@if (_summary is null)
{
    <p>Loading&hellip;</p>
}
else if (_summary.TotalTasks == 0 && string.IsNullOrEmpty(_summary.ProjectName))
{
    <p>Project not found.</p>
}
else
{
    <MudText Typo="Typo.h4">@_summary.ProjectName</MudText>

    <MudButton OnClick="RefreshAsync" StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>

    <MudGrid>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Total</MudText>
                <MudText Typo="Typo.h5">@_summary.TotalTasks</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Done</MudText>
                <MudText Typo="Typo.h5">@_summary.Done</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">In progress</MudText>
                <MudText Typo="Typo.h5">@_summary.InProgress</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Blocked</MudText>
                <MudText Typo="Typo.h5">@_summary.Blocked</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Not started</MudText>
                <MudText Typo="Typo.h5">@_summary.NotStarted</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Overdue</MudText>
                <MudText Typo="Typo.h5">@_summary.Overdue</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">Discovered</MudText>
                <MudText Typo="Typo.h5">@_summary.Discovered</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle2">% complete</MudText>
                <MudText Typo="Typo.h5">@_summary.PercentComplete%</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h5">Planner Grid</MudText>

    @if (!string.IsNullOrEmpty(_objectiveErrorMessage))
    {
        <MudAlert Severity="Severity.Error">@_objectiveErrorMessage</MudAlert>
    }

    <EditForm Model="this" OnValidSubmit="AddObjectiveAsync">
        <MudTextField @bind-Value="_newObjectiveTitle" Label="Title" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Add</MudButton>
    </EditForm>

    <MudText Typo="Typo.h6">Add task</MudText>

    @if (!string.IsNullOrEmpty(_taskErrorMessage))
    {
        <MudAlert Severity="Severity.Error">@_taskErrorMessage</MudAlert>
    }

    <EditForm Model="this" OnValidSubmit="AddTaskAsync">
        <div>
            <MudTextField @bind-Value="_newTaskTitle" Label="Title" />
        </div>
        <div>
            <MudSelect T="int?" @bind-Value="_newTaskObjectiveId" Label="Objective">
                <MudSelectItem Value="@((int?)null)">&mdash; Ungrouped &mdash;</MudSelectItem>
                @foreach (var objective in _objectives ?? new List<Objective>())
                {
                    <MudSelectItem Value="@((int?)objective.Id)">@objective.Title</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div>
            <MudSelect T="int?" @bind-Value="_newTaskAssigneeId" Label="Assignee">
                <MudSelectItem Value="@((int?)null)">&mdash; Unassigned &mdash;</MudSelectItem>
                @foreach (var member in _teamMembers ?? new List<User>())
                {
                    <MudSelectItem Value="@((int?)member.Id)">@member.FullName</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div>
            <MudDatePicker @bind-Date="_newTaskDeadline" Label="Deadline" />
        </div>
        <div>
            <MudTextField @bind-Value="_newTaskDescription" Label="Description" Lines="3" />
        </div>
        <div>
            <MudCheckBox @bind-Value="_newTaskIsDiscovered" Label="Discovered in a meeting" />
        </div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Add task</MudButton>
    </EditForm>

    <MudSimpleTable Hover="true" Dense="true">
        <thead>
            <tr>
                <th>Tasks</th>
                <th>Owner / status</th>
                <th>Progress checklist</th>
            </tr>
        </thead>
    </MudSimpleTable>

    @if (_objectives is null)
    {
        <p>Loading objectives&hellip;</p>
    }
    else if (_objectives.Count == 0)
    {
        <MudText>No objectives yet.</MudText>
    }
    else
    {
        @foreach (var objective in _objectives)
        {
            <MudText Typo="Typo.h6">@objective.Title</MudText>
            @if (objective.Tasks.Count == 0)
            {
                <MudText>No tasks yet.</MudText>
            }
            else
            {
                <MudSimpleTable Hover="true" Dense="true">
                    <tbody>
                        @foreach (var task in objective.Tasks)
                        {
                            <TaskRow WorkItem="task" StatusChanged="RefreshAsync" />
                        }
                    </tbody>
                </MudSimpleTable>
            }
        }
    }

    @if (_ungroupedTasks is { Count: > 0 })
    {
        <MudText Typo="Typo.h6">Ungrouped</MudText>
        <MudSimpleTable Hover="true" Dense="true">
            <tbody>
                @foreach (var task in _ungroupedTasks)
                {
                    <TaskRow WorkItem="task" StatusChanged="RefreshAsync" />
                }
            </tbody>
        </MudSimpleTable>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ProjectSummary? _summary;
    private List<Objective>? _objectives;
    private List<User>? _teamMembers;
    private List<WorkItem>? _ungroupedTasks;
    private string _newObjectiveTitle = string.Empty;
    private string? _objectiveErrorMessage;

    private string _newTaskTitle = string.Empty;
    private int? _newTaskObjectiveId;
    private int? _newTaskAssigneeId;
    private DateTime? _newTaskDeadline;
    private string? _newTaskDescription;
    private bool _newTaskIsDiscovered;
    private string? _taskErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        _summary = await PlanningService.GetProjectSummaryAsync(Id);
        _objectives = await PlanningService.GetPlannerForProjectAsync(Id);
        _teamMembers = await PlanningService.GetTeamMembersAsync();
        _ungroupedTasks = await PlanningService.GetUngroupedTasksForProjectAsync(Id);
    }

    private async Task RefreshAsync()
    {
        _summary = await PlanningService.GetProjectSummaryAsync(Id);
        _objectives = await PlanningService.GetPlannerForProjectAsync(Id);
        _teamMembers = await PlanningService.GetTeamMembersAsync();
        _ungroupedTasks = await PlanningService.GetUngroupedTasksForProjectAsync(Id);
    }

    private async Task AddObjectiveAsync()
    {
        try
        {
            await PlanningService.AddObjectiveAsync(Id, _newObjectiveTitle);

            _newObjectiveTitle = string.Empty;
            _objectiveErrorMessage = null;
            _objectives = await PlanningService.GetPlannerForProjectAsync(Id);
        }
        catch (ManagerPlanner.Core.Validation.ValidationException ex)
        {
            _objectiveErrorMessage = ex.Message;
        }
    }

    private async Task AddTaskAsync()
    {
        try
        {
            // Matches the legacy MainWindowViewModel.AddTaskAsync's pre-processing exactly:
            // description is trimmed/nulled by the caller, not by the service.
            var description = string.IsNullOrWhiteSpace(_newTaskDescription)
                ? null
                : _newTaskDescription.Trim();

            await PlanningService.AddTaskAsync(
                Id,
                _newTaskTitle,
                description,
                _newTaskAssigneeId,
                _newTaskDeadline,
                _newTaskIsDiscovered,
                _newTaskObjectiveId);

            _newTaskTitle = string.Empty;
            _newTaskObjectiveId = null;
            _newTaskAssigneeId = null;
            _newTaskDeadline = null;
            _newTaskDescription = null;
            _newTaskIsDiscovered = false;
            _taskErrorMessage = null;

            _objectives = await PlanningService.GetPlannerForProjectAsync(Id);
            _ungroupedTasks = await PlanningService.GetUngroupedTasksForProjectAsync(Id);
        }
        catch (ManagerPlanner.Core.Validation.ValidationException ex)
        {
            _taskErrorMessage = ex.Message;
        }
    }
}
