@inject PlanningService PlanningService

<tr>
    <td>
        @WorkItem.Title
        @if (WorkItem.Deadline.HasValue)
        {
            <div style="font-size:0.85em;color:#606060;">@WorkItem.Deadline.Value.ToString("yyyy-MM-dd")</div>
        }
    </td>
    <td>
        <div>@(WorkItem.Assignee?.FullName ?? "Unassigned")</div>
        <div><MudChip T="string" Color="@StatusColor" Size="Size.Small">@StatusText</MudChip></div>
        <div>
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton OnClick="() => SetStatusAsync(WorkItemStatus.NotStarted)">Not started</MudButton>
                <MudButton OnClick="() => SetStatusAsync(WorkItemStatus.InProgress)">In progress</MudButton>
                <MudButton OnClick="() => SetStatusAsync(WorkItemStatus.Blocked)">Blocked</MudButton>
                <MudButton OnClick="() => SetStatusAsync(WorkItemStatus.Done)">Mark done</MudButton>
            </MudButtonGroup>
        </div>
    </td>
    <td>&mdash;</td>
</tr>

@code {
    [Parameter]
    public ManagerPlanner.Core.Domain.WorkItem WorkItem { get; set; } = null!;

    [Parameter]
    public EventCallback StatusChanged { get; set; }

    private string StatusText => WorkItem.Status switch
    {
        WorkItemStatus.NotStarted => "Not started",
        WorkItemStatus.InProgress => "In progress",
        WorkItemStatus.Blocked => "Blocked",
        WorkItemStatus.Done => "Done",
        _ => WorkItem.Status.ToString()
    };

    private Color StatusColor => WorkItem.Status switch
    {
        WorkItemStatus.NotStarted => Color.Default,
        WorkItemStatus.InProgress => Color.Info,
        WorkItemStatus.Blocked => Color.Error,
        WorkItemStatus.Done => Color.Success,
        _ => Color.Default
    };

    private async Task SetStatusAsync(WorkItemStatus newStatus)
    {
        var changedById = await PlanningService.GetCurrentManagerIdAsync();
        await PlanningService.ChangeStatusAsync(WorkItem.Id, newStatus, changedById);
        await StatusChanged.InvokeAsync();
    }
}
