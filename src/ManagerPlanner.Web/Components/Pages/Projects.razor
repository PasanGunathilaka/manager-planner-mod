@page "/projects"
@inject PlanningService PlanningService
@inject IDialogService DialogService

<PageTitle>Projects</PageTitle>

<h1>Projects</h1>

@if (_projects is null)
{
    <MudAlert Severity="Severity.Info">Loading projects&hellip;</MudAlert>
}
else if (_projects.Count == 0)
{
    <MudAlert Severity="Severity.Info">No projects yet.</MudAlert>
}
else
{
    <MudList T="int">
        @foreach (var project in _projects)
        {
            <MudListItem T="int" @key="project.Id">
                <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                    <a href="@($"/projects/{project.Id}")" style="flex:1;text-decoration:none;color:inherit;">
                        @project.Name
                        @if (!string.IsNullOrWhiteSpace(project.Description))
                        {
                            <text> &mdash; @project.Description</text>
                        }
                    </a>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteProjectAsync(project)" />
                </div>
            </MudListItem>
        }
    </MudList>
}

<h2>Add project</h2>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
}

<EditForm Model="this" OnValidSubmit="AddProjectAsync">
    <div>
        <label>
            Name:
            <MudTextField @bind-Value="_newName" Label="Name" />
        </label>
    </div>
    <div>
        <label>
            Description:
            <MudTextField @bind-Value="_newDescription" Label="Description" />
        </label>
    </div>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Add project</MudButton>
</EditForm>

@code {
    private List<Project>? _projects;
    private string _newName = string.Empty;
    private string? _newDescription;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _projects = await PlanningService.GetProjectsAsync();
    }

    private async Task AddProjectAsync()
    {
        try
        {
            var ownerId = await PlanningService.GetCurrentManagerIdAsync();
            await PlanningService.AddProjectAsync(_newName, _newDescription, ownerId);

            _newName = string.Empty;
            _newDescription = null;
            _errorMessage = null;
            _projects = await PlanningService.GetProjectsAsync();
        }
        catch (ManagerPlanner.Core.Validation.ValidationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task DeleteProjectAsync(Project project)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete project", $"Delete project '{project.Name}' and all its objectives, tasks, checklist items and notes?\nThis cannot be undone.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            await PlanningService.DeleteProjectAsync(project.Id);
            _projects = await PlanningService.GetProjectsAsync();
        }
    }
}
