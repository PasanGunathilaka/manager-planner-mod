@page "/"
@using ManagerPlanner.Core.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<PlanningDbContext> DbFactory

<PageTitle>Manager Planner</PageTitle>

<h1>Manager Planner</h1>

@if (_canConnect is null)
{
    <MudAlert Severity="Severity.Info">Checking database connectivity&hellip;</MudAlert>
}
else if (_canConnect == true)
{
    <MudAlert Severity="Severity.Success">Database connected.</MudAlert>
}
else
{
    <MudAlert Severity="Severity.Error">Could not connect to the database.</MudAlert>
}

@code {
    private bool? _canConnect;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _canConnect = await db.Database.CanConnectAsync();
    }
}
